# По умолчанию SQLite в data/app.db
# DATABASE_URL=sqlite:///data/app.db
APIFY_TOKEN=

# AI-шлюз NeuroAPI (OpenAI-совместимый). Base URL и названия моделей — из личного кабинета NeuroAPI
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1

# Необязательно: отдельный провайдер для транскрипции, если NeuroAPI её не поддерживает
# AI_TRANSCRIBE_API_KEY=
# AI_TRANSCRIBE_BASE_URL=

